\@writefile{toc}{\contentsline {subsection}{\numberline {C}Boxes Are Tall, and the Classes Differ Sharply}{4}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Representative annotated frames from LuggageDataset\nobreakspace  {}v6i. The images are drawn from fixed or quasi-static surveillance cameras in transport hubs and indoor public space, and illustrate the conditions the benchmark is built to capture: elevated, oblique viewpoints in which luggage occupies a small fraction of the frame; dense pedestrian traffic with frequent partial occlusion of the bag by its own owner; wide variation in illumination, from daylit concourses to artificially lit interiors and screen-lit walls; and all three classes co-occurring at very different apparent scales within a single frame. The annotations shown are the released ground truth. Note that these are the raw frames: unlike our earlier presentation of this corpus, no augmentation is applied anywhere in this paper, so every number reported in Section\nobreakspace  {}\ref  {sec:results} is obtained on unmodified imagery.\relax }}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:samples}{{1}{4}{Representative annotated frames from LuggageDataset~v6i. The images are drawn from fixed or quasi-static surveillance cameras in transport hubs and indoor public space, and illustrate the conditions the benchmark is built to capture: elevated, oblique viewpoints in which luggage occupies a small fraction of the frame; dense pedestrian traffic with frequent partial occlusion of the bag by its own owner; wide variation in illumination, from daylit concourses to artificially lit interiors and screen-lit walls; and all three classes co-occurring at very different apparent scales within a single frame. The annotations shown are the released ground truth. Note that these are the raw frames: unlike our earlier presentation of this corpus, no augmentation is applied anywhere in this paper, so every number reported in Section~\ref {sec:results} is obtained on unmodified imagery.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {D}A Leakage-Free Split}{4}{subsection.3.4}\protected@file@percent }
\newlabel{sec:dataset:leakage}{{D}{4}{A Leakage-Free Split}{subsection.3.4}{}}
\citation{catargiu2026weapon}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The leakage-free splitting procedure. \textbf  {Step 1:} each frame is reduced to a 64-bit perceptual (difference) hash; any two frames whose hashes differ in at most five bits are linked, and connected components extracted by union-find group mutually near-identical frames into clusters, so that one cluster corresponds to one real scene. \textbf  {Step 2:} each whole cluster, never an individual frame, is assigned to a single split by a stratified greedy procedure, so no near-duplicate frame can cross a split boundary by construction. The panels illustrate the method with the counts from the weapon-detection corpus in which it was first validated \cite  {catargiu2026weapon}; applied unchanged to LuggageDataset\nobreakspace  {}v6i at the same Hamming threshold of five, it produces the $75/15/10$ partition of Table\nobreakspace  {}\ref  {tab:splits} and a cross-split audit of that partition returns \textbf  {zero} clusters spanning subsets and \textbf  {zero} near-duplicate pairs between any two subsets.\relax }}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:leakage}{{2}{5}{The leakage-free splitting procedure. \textbf {Step 1:} each frame is reduced to a 64-bit perceptual (difference) hash; any two frames whose hashes differ in at most five bits are linked, and connected components extracted by union-find group mutually near-identical frames into clusters, so that one cluster corresponds to one real scene. \textbf {Step 2:} each whole cluster, never an individual frame, is assigned to a single split by a stratified greedy procedure, so no near-duplicate frame can cross a split boundary by construction. The panels illustrate the method with the counts from the weapon-detection corpus in which it was first validated \cite {catargiu2026weapon}; applied unchanged to LuggageDataset~v6i at the same Hamming threshold of five, it produces the $75/15/10$ partition of Table~\ref {tab:splits} and a cross-split audit of that partition returns \textbf {zero} clusters spanning subsets and \textbf {zero} near-duplicate pairs between any two subsets.\relax }{figure.caption.6}{}}
